{
  "name": "@ovv/dsh-magpie-sync",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "为 DSH 添加利用 Magpie 宣告的输入模态及 thinking level 信息的功能。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "magpie",
    "reasoning-effort",
    "modalities"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outloudvi/dsh-magpie-sync.git"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
